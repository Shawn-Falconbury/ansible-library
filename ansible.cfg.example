# Copy to ansible.cfg and adjust. ansible.cfg is gitignored so a local copy
# with site-specific paths cannot be committed by accident.
[defaults]
inventory = ./inventory/hosts.yml
roles_path = ./roles
collections_path = ./collections
host_key_checking = True
retry_files_enabled = False
# The `yaml` stdout callback lives in community.general, not ansible-core.
# Enabling it before `ansible-galaxy collection install -r requirements.yml`
# has run makes every ansible command fail with "Invalid callback for stdout
# specified: yaml", which does not obviously point at a missing collection.
# Uncomment once collections are installed.
# stdout_callback = yaml
interpreter_python = auto_silent
forks = 15

[persistent_connection]
command_timeout = 60
connect_timeout = 60

[ssh_connection]
pipelining = True
