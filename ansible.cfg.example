# Copy to ansible.cfg and adjust. ansible.cfg is gitignored so a local copy
# with site-specific paths cannot be committed by accident.
[defaults]
inventory = ./inventory/hosts.yml
roles_path = ./roles

# filter_plugins MUST be declared explicitly.
#
# Ansible auto-discovers a filter_plugins/ directory adjacent to the
# PLAYBOOK, not at the project root. Every playbook here lives in a
# subdirectory (playbooks/network/, playbooks/linux/, ...), so the
# repository-root filter_plugins/ is never found by that mechanism.
#
# Without this line the failure is a template error reading
# "No filter named 'mask_ip'", which looks like a typo in the template
# rather than a search-path problem. Worse, a report that fails to render
# is the GOOD outcome here -- the filters exist to keep live addresses out
# of distributed reports.
filter_plugins = ./filter_plugins
collections_path = ./collections
host_key_checking = True
retry_files_enabled = False
# The `yaml` stdout callback lives in community.general, not ansible-core.
# Enabling it before `ansible-galaxy collection install -r requirements.yml`
# has run makes every ansible command fail with "Invalid callback for stdout
# specified: yaml", which does not obviously point at a missing collection.
# Uncomment once collections are installed.
# stdout_callback = yaml
interpreter_python = auto_silent
forks = 15

[persistent_connection]
command_timeout = 60
connect_timeout = 60

[ssh_connection]
pipelining = True
